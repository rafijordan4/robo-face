{
  "manifest_version": 3,
  "name": "Robo Face Bridge",
  "version": "2.0",
  "description": "Jembatan Robo Face: status video/password/notif, perintah tab, dan agen AI dengan kursor kuning.",
  "permissions": ["tabs", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["notif_main.js"],
      "all_frames": false,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
